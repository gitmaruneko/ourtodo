{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ourtodo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "AUTH_MODE": "line"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ourtodo-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": []
}
